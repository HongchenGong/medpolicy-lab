# Use a persistent local disk, not a network filesystem or ephemeral container layer.
DATA_DIR=./data
# Public deployment: set the exact HTTPS origin and COOKIE_SECURE=true.
# APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=false
# Enable only behind your own reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false

# Optional cloud mode (server-only): GitHub + Render Free + Supabase Free.
# Set actual values in the hosting service's secret environment settings, never in Git.
# DATABASE_URL=
# DATABASE_CA_CERT=  # Only if the provider supplies a custom trusted CA.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=medpolicy-private
# ADMIN_INITIAL_PASSWORD=
# SEED_CONFIG_JSON=  # Contents of the ignored private seed configuration; first boot only.
